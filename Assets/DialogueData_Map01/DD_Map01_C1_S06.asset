  m_Script: {fileID: 11500000, guid: 5b9d68f96c245d44bbeb3b0dd287c065, type: 3}
  m_Name: DD_Map01_C1_S06
  m_EditorClassIdentifier: 
  dialogueID: MAP01_C1_S06
  lines:
  - displayMode: 0
    speakerName: Minh
    dialogueText: "Phi\u1EBFu ki\u1EC3m k\xEA K-03... Tr\u1EA1m nghi\xEAn c\u1EE9u
      s\u1ED1 03."
    characterPortrait: {fileID: 0}
    backgroundSprite: {fileID: 0}
  - displayMode: 0
    speakerName: Minh
    dialogueText: "Thi\u1EBFt b\u1ECB \u0111o ho\u1EA1t \u0111\u1ED9ng th\u1EA7n
      kinh, m\u1EABu sinh h\u1ECDc v\xE0 v\u1EADt li\u1EC7u l\u1EA5y t\u1EEB khu
      v\u1EF1c hang ph\xEDa \u0111\xF4ng..."
    characterPortrait: {fileID: 0}
    backgroundSprite: {fileID: 0}
  - displayMode: 0
    speakerName: Minh
    dialogueText: "C\xE1c m\u1EABu v\u1EADt li\xEAn quan \u0111\u1EBFn d\u1EF1 \xE1n
      H\u1EA3i T\xE2m ph\u1EA3i \u0111\u01B0\u1EE3c ni\xEAm phong. Kh\xF4ng \u0111\u01B0\u1EE3c
      t\u1EF1 \xFD m\u1EDF."
    characterPortrait: {fileID: 0}
    backgroundSprite: {fileID: 0}
  - displayMode: 0
    speakerName: Minh
    dialogueText: "C\xF3 v\u1EBB nh\u1EEFng th\u1EE9 n\xE0y \u0111\u01B0\u1EE3c chuy\u1EC3n
      \u0111\u1EBFn Tr\u1EA1m nghi\xEAn c\u1EE9u s\u1ED1 03. M\xECnh c\u1EA7n t\xECm
      hi\u1EC3u th\xEAm."
    characterPortrait: {fileID: 0}
    backgroundSprite: {fileID: 0}
