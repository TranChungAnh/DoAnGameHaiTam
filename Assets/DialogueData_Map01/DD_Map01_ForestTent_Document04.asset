  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5b9d68f96c245d44bbeb3b0dd287c065, type: 3}
  m_Name: DD_Map01_ForestTent_Document04
  m_EditorClassIdentifier: 
  dialogueID: Map01_ForestTent_Document04
  lines:
  - displayMode: 0
    speakerName: 
    dialogueText: "C\xF3 nh\u1EEFng ng\u01B0\u1EDDi nh\u1EDB c\xF9ng m\u1ED9t s\u1EF1
      ki\u1EC7n theo hai c\xE1ch ho\xE0n to\xE0n kh\xE1c nhau."
    characterPortrait: {fileID: 0}
    backgroundSprite: {fileID: 0}
  - displayMode: 0
    speakerName: 
    dialogueText: "Ban \u0111\u1EA7u, ch\xFAng t\xF4i cho r\u1EB1ng \u0111\xF3 l\xE0
      do c\u0103ng th\u1EB3ng. Nh\u01B0ng nh\u1EEFng tr\u01B0\u1EDDng h\u1EE3p t\u01B0\u01A1ng
      t\u1EF1 v\u1EABn xu\u1EA5t hi\u1EC7n ngay c\u1EA3 khi ng\u01B0\u1EDDi tham
      gia \u0111ang b\xECnh t\u0129nh."
    characterPortrait: {fileID: 0}
    backgroundSprite: {fileID: 0}
  - displayMode: 0
    speakerName: 
    dialogueText: "N\u1EBFu kh\xF4ng ph\u1EA3i do c\u0103ng th\u1EB3ng, v\u1EADy
      \u0111i\u1EC1u g\xEC \u0111ang khi\u1EBFn k\xFD \u1EE9c c\u1EE7a h\u1ECD thay
      \u0111\u1ED5i?"
    characterPortrait: {fileID: 0}
    backgroundSprite: {fileID: 0}
