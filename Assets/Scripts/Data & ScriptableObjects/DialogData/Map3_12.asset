%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5b9d68f96c245d44bbeb3b0dd287c065, type: 3}
  m_Name: Map3_12
  m_EditorClassIdentifier: 
  dialogueID: 12
  lines:
  - displayMode: 0
    speakerName: 
    dialogueText: "\u201CTrong m\u1ED9t \u0111\xEAm t\u1ED1i, m\u1ED9t v\u1EC7t s\xE1ng
      xu\u1EA5t hi\u1EC7n ph\xEDa tr\xEAn H\u1EA3i V\u1ECDng.\u201D\nNg\u01B0\u1EDDi
      d\xE2n: \u201CNh\xECn l\xEAn tr\u1EDDi k\xECa! Th\u1EE9 g\xEC \u0111ang r\u01A1i
      xu\u1ED1ng v\u1EADy?\u201D"
    characterPortrait: {fileID: 0}
    backgroundSprite: {fileID: 21300000, guid: 81fc682d807a2a24db396d19cfeb9af2, type: 3}
  - displayMode: 0
    speakerName: 
    dialogueText: "\u201CV\u1EADt th\u1EC3 \u1EA5y va v\xE0o h\xF2n \u0111\u1EA3o.
      Khi \xE1nh s\xE1ng l\u1EAFng xu\u1ED1ng, m\u1ED9t h\u1ED1 s\xE2u \u0111\xE3
      xu\u1EA5t hi\u1EC7n gi\u1EEFa v\xF9ng \u0111\u1EA5t ch\xE1y s\xE9m.\u201D"
    characterPortrait: {fileID: 0}
    backgroundSprite: {fileID: 21300000, guid: 22cd1e27b0eac50459f26a30c15a443a, type: 3}
  - displayMode: 0
    speakerName: 
    dialogueText: "C\xFAi xu\u1ED1ng! Mau tr\xE1nh \u0111i!\u201D\n\u201CV\u1EADt
      th\u1EC3 \u1EA5y va v\xE0o h\xF2n \u0111\u1EA3o. Khi \xE1nh s\xE1ng l\u1EAFng
      xu\u1ED1ng, m\u1ED9t h\u1ED1 s\xE2u \u0111\xE3 xu\u1EA5t hi\u1EC7n gi\u1EEFa
      v\xF9ng \u0111\u1EA5t ch\xE1y s\xE9m.\u201D"
    characterPortrait: {fileID: -189674907, guid: f19ca5cf7c2cf2a4aa7e4a279bb8900e, type: 3}
    backgroundSprite: {fileID: 21300000, guid: df398969ca581e34ca6c0f0de1ee6a49, type: 3}
  - displayMode: 0
    speakerName: "Ng\u01B0\u1EDDi \u0111i c\xF9ng:"
    dialogueText: "\xC1nh s\xE1ng v\u1EABn c\xF2n \u1EDF d\u01B0\u1EDBi \u0111\xF3\u2026\u201D\n\u201C\u0110\u1EEBng
      xu\u1ED1ng v\u1ED9i. Ch\xFAng ta ch\u01B0a bi\u1EBFt th\u1EE9 g\xEC v\u1EEBa
      r\u01A1i xu\u1ED1ng.\u201D"
    characterPortrait: {fileID: 958862177, guid: 9291e4e87da89f2488cb842056be6a22, type: 3}
    backgroundSprite: {fileID: 21300000, guid: 69d7bec6591338347aaca294f4edbf26, type: 3}
  - displayMode: 0
    speakerName: Minh
    dialogueText: " \u201CM\xECnh v\u1EEBa nh\xECn th\u1EA5y c\u1EA3nh thi\xEAn th\u1EA1ch
      r\u01A1i xu\u1ED1ng\u2026\u201D"
    characterPortrait: {fileID: 958862177, guid: 9291e4e87da89f2488cb842056be6a22, type: 3}
    backgroundSprite: {fileID: 21300000, guid: a8fec6d8a707d364abe650deae00fe28, type: 3}
  - displayMode: 0
    speakerName: Minh
    dialogueText: "\u201CNh\u01B0ng tr\xEAn m\u1EA3nh tranh ch\u1EC9 c\xF3 v\xE0i
      h\xECnh kh\u1EAFc. T\u1EA1i sao m\xECnh l\u1EA1i th\u1EA5y r\xF5 \u0111\u1EBFn
      v\u1EADy?\u201D"
    characterPortrait: {fileID: 958862177, guid: 9291e4e87da89f2488cb842056be6a22, type: 3}
    backgroundSprite: {fileID: 0}
