--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5b9d68f96c245d44bbeb3b0dd287c065, type: 3}
  m_Name: Map3_13
  m_EditorClassIdentifier: 
  dialogueID: 13
  lines:
  - displayMode: 0
    speakerName: 
    dialogueText: "\u201CH\u1ECD t\xECm th\u1EA5y nh\u1EEFng nguy\xEAn li\u1EC7u
      k\u1EF3 l\u1EA1 quanh n\u01A1i thi\xEAn th\u1EA1ch r\u01A1i xu\u1ED1ng v\xE0
      ch\u1EBF bi\u1EBFn ch\xFAng th\xE0nh B\u1ED9t M\u1ED9ng Th\u1EF1c.\u201D\n
      \u201CH\u1ECD s\u1EED d\u1EE5ng th\u1EE9 b\u1ED9t \u1EA5y m\xE0 ch\u01B0a hi\u1EC3u
      n\xF3 s\u1EBD l\xE0m g\xEC v\u1EDBi t\xE2m tr\xED m\xECnh.\u201D"
    characterPortrait: {fileID: 0}
    backgroundSprite: {fileID: 21300000, guid: e3d5ae5dac0a01f488e53b0a342873ea, type: 3}
  - displayMode: 0
    speakerName: 
    dialogueText: "Con v\u1EC1 r\u1ED3i sao? Ta c\u1EE9 ngh\u0129 s\u1EBD kh\xF4ng
      \u0111\u01B0\u1EE3c g\u1EB7p l\u1EA1i con n\u1EEFa\u2026"
    characterPortrait: {fileID: 958862177, guid: 9291e4e87da89f2488cb842056be6a22, type: 3}
    backgroundSprite: {fileID: 21300000, guid: 9665e19a96838ec40a69d8c85489d095, type: 3}
  - displayMode: 0
    speakerName: 
    dialogueText: "V\u1EEBa r\u1ED3i con c\xF2n \u0111\u1EE9ng \u1EDF \u0111\xE2y\u2026"
    characterPortrait: {fileID: -189674907, guid: f19ca5cf7c2cf2a4aa7e4a279bb8900e, type: 3}
    backgroundSprite: {fileID: 21300000, guid: 331da9b991e6fef40be58294cafd430d, type: 3}
  - displayMode: 0
    speakerName: 
    dialogueText: "\u201CC\xF9ng m\u1ED9t n\u01A1i, m\u1ED7i ng\u01B0\u1EDDi l\u1EA1i
      nh\u1EDB m\u1ED9t qu\xE1 kh\u1EE9 kh\xE1c nhau.\u201D\n"
    characterPortrait: {fileID: 958862177, guid: 9291e4e87da89f2488cb842056be6a22, type: 3}
    backgroundSprite: {fileID: 21300000, guid: 1f37d6f8ed0b2a64fba9418edd1436f5, type: 3}
  - displayMode: 0
    speakerName: Minh
    dialogueText: "\u201CH\u1ECD kh\xF4ng ch\u1EC9 nh\xECn th\u1EA5y \u1EA3o \u1EA3nh\u2026
      h\u1ECD c\xF2n tin nh\u1EEFng \u0111i\u1EC1u \u1EA5y \u0111\xE3 th\u1EADt s\u1EF1
      x\u1EA3y ra.\u201D"
    characterPortrait: {fileID: 958862177, guid: 9291e4e87da89f2488cb842056be6a22, type: 3}
    backgroundSprite: {fileID: 21300000, guid: b933df76f690039439c0ee6535f733c2, type: 3}
  - displayMode: 0
    speakerName: Minh
    dialogueText: "\u201CLi\u1EC7u m\xECnh c\u0169ng \u0111ang nh\u01B0 v\u1EADy?\u201D"
    characterPortrait: {fileID: 958862177, guid: 9291e4e87da89f2488cb842056be6a22, type: 3}
    backgroundSprite: {fileID: 21300000, guid: b933df76f690039439c0ee6535f733c2, type: 3}
