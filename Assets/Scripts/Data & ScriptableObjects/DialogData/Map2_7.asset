%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5b9d68f96c245d44bbeb3b0dd287c065, type: 3}
  m_Name: Map2_7
  m_EditorClassIdentifier: 
  dialogueID: 7
  lines:
  - displayMode: 0
    speakerName: 
    dialogueText: "Khoan \u0111\xE3... nh\u1EEFng h\xECnh \u1EA3nh n\xE0y l\xE0 g\xEC?\n"
    characterPortrait: {fileID: 0}
    backgroundSprite: {fileID: 21300000, guid: e5c17536cb3ff6245bfb6059885aea9f, type: 3}
  - displayMode: 0
    speakerName: 
    dialogueText: "Nhanh th\u1EADt... M\xECnh kh\xF4ng k\u1ECBp tr\xE1nh!\n"
    characterPortrait: {fileID: 0}
    backgroundSprite: {fileID: 21300000, guid: 10a3bac6c832bc54b90edf7051e72ba7, type: 3}
  - displayMode: 0
    speakerName: 
    dialogueText: "N\xF3 v\u1EEBa lao h\u1EE5t... \u0110\xE2y l\xE0 c\u01A1 h\u1ED9i
      \u0111\u1EC3 ph\u1EA3n c\xF4ng!"
    characterPortrait: {fileID: 0}
    backgroundSprite: {fileID: 21300000, guid: 2ea9b270e463f234495c2238bdade569, type: 3}
  - displayMode: 0
    speakerName: 
    dialogueText: "Ph\u1EA3i gi\u1EEF kho\u1EA3ng c\xE1ch... \u0110\u1EE3i n\xF3
      lao t\u1EDBi r\u1ED3i n\xE9 sang b\xEAn!"
    characterPortrait: {fileID: 0}
    backgroundSprite: {fileID: 21300000, guid: 64e9c6696aba571429f9cb7ef4efc919, type: 3}
  - displayMode: 0
    speakerName: 
    dialogueText: "Ph\u1EA3i ngh\u1EC9 m\u1ED9t ch\xFAt... N\u1EBFu c\u1EE9 ti\u1EBFp
      t\u1EE5c chi\u1EBFn \u0111\u1EA5u, m\xECnh s\u1EBD kh\xF4ng tr\u1EE5 n\u1ED5i."
    characterPortrait: {fileID: 0}
    backgroundSprite: {fileID: 21300000, guid: 809af757501be864abf215ab7af82b99, type: 3}
  - displayMode: 0
    speakerName: 
    dialogueText: "L\u1EA1i g\u1EB7p n\xF3 n\u1EEFa... M\xECnh ph\u1EA3i \xE1p d\u1EE5ng
      c\xE1ch \u0111\xE3 t\xECm ra l\u1EA7n tr\u01B0\u1EDBc!"
    characterPortrait: {fileID: 0}
    backgroundSprite: {fileID: 21300000, guid: 4f9582681cbdb7b4eb5a7f43a4bbaaaa, type: 3}
  - displayMode: 0
    speakerName: 
    dialogueText: "Cu\u1ED1i c\xF9ng c\u0169ng h\u1EA1 \u0111\u01B0\u1EE3c n\xF3...
      M\xECnh \u0111\xE3 chi\u1EBFn \u0111\u1EA5u v\u1EDBi ch\xFAng tr\u01B0\u1EDBc
      \u0111\xE2y, kh\xF4ng ch\u1EC9 m\u1ED9t l\u1EA7n."
    characterPortrait: {fileID: 0}
    backgroundSprite: {fileID: 21300000, guid: e5774c0f645fd854b8940ba7a2a76ae4, type: 3}
