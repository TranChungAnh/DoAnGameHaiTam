--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5b9d68f96c245d44bbeb3b0dd287c065, type: 3}
  m_Name: Map2_5
  m_EditorClassIdentifier: 
  dialogueID: 5
  lines:
  - displayMode: 0
    speakerName: 
    dialogueText: "M\xECnh nh\u1EDB \u0111\xE3 t\u1EEBng \u0111\u1EBFn \u0111\xE2y
      khi c\xF2n nh\u1ECF."
    characterPortrait: {fileID: 0}
    backgroundSprite: {fileID: 21300000, guid: 076f4750644dd38449cc66562d6ef4a4, type: 3}
  - displayMode: 0
    speakerName: 
    dialogueText: "B\u1ED1 \u01A1i, \u0111\xE2y l\xE0 \u0111\xE2u v\u1EADy?"
    characterPortrait: {fileID: 0}
    backgroundSprite: {fileID: 21300000, guid: 1879f0ac8a827c2489e99155c3249a9f, type: 3}
  - displayMode: 0
    speakerName: "Nguy\u1EC5n An"
    dialogueText: "\u0110i theo b\u1ED1. B\u1ED1 s\u1EBD cho con xem n\u01A1i m\u1ECDi
      ng\u01B0\u1EDDi l\xE0m vi\u1EC7c."
    characterPortrait: {fileID: 0}
    backgroundSprite: {fileID: 21300000, guid: 9dbf10e6221f20b4dbb4215cf49ffc04, type: 3}
  - displayMode: 0
    speakerName: 
    dialogueText: "M\xECnh nh\u1EDB b\u1ED1 t\u1EEBng d\u1EABn m\xECnh \u0111i qua
      \u0111\xE2y, nh\u01B0ng n\u01A1i n\xE0y \u0111\xE2u c\xF3 l\u1ED1i \u0111i
      nh\u01B0 v\u1EADy?"
    characterPortrait: {fileID: 0}
    backgroundSprite: {fileID: 21300000, guid: c4ed13fc752a0ad4f8a87f1137c600c4, type: 3}
  - displayMode: 0
    speakerName: 
    dialogueText: "R\u1ED1t cu\u1ED9c m\xECnh \u0111\xE3 nh\u1EDB sai \u0111i\u1EC1u
      g\xEC?"
    characterPortrait: {fileID: 0}
    backgroundSprite: {fileID: 21300000, guid: f7d9325a2b6253b4a99669f067f9f6d0, type: 3}
  - displayMode: 0
    speakerName: 
    dialogueText: "Th\xEC nh\u1EEFng chuy\u1EC7n kh\xE1c m\xE0 m\xECnh nh\u1EDB li\u1EC7u
      c\xF3 c\xF2n \u0111\xE1ng tin kh\xF4ng?"
    characterPortrait: {fileID: 0}
    backgroundSprite: {fileID: 21300000, guid: 41a5b2fc1a589e440b41cd1b1fc9d500, type: 3}
