%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5b9d68f96c245d44bbeb3b0dd287c065, type: 3}
  m_Name: Map3_15
  m_EditorClassIdentifier: 
  dialogueID: 1
  lines:
  - displayMode: 0
    speakerName: 
    dialogueText: "C\xE1c k\xFD hi\u1EC7u \u0111ang ph\u1EA3n \u1EE9ng\u2026 Gi\u1EEF
      nguy\xEAn v\u1ECB tr\xED!\u201D\n\u201C\xC1nh s\xE1ng t\u1EEB b\u1ED1n tr\u1EE5
      n\u1ED1i l\u1EA1i, bao quanh th\u1EF1c th\u1EC3 \u1EDF gi\u1EEFa s\u1EA3nh.\u201D\n"
    characterPortrait: {fileID: 0}
    backgroundSprite: {fileID: 21300000, guid: 9f750d90e3653f44aa262819f3f872f3, type: 3}
  - displayMode: 0
    speakerName: 
    dialogueText: "\u201CNh\u1EEFng ng\u01B0\u1EDDi s\u1ED1ng s\xF3t t\u1EADp h\u1EE3p
      quanh H\u1EA3i T\xE2m. H\u1ECD chu\u1EA9n b\u1ECB m\u1ED9t nghi th\u1EE9c v\u1EDBi
      hy v\u1ECDng ng\u0103n s\u1EE9c m\u1EA1nh c\u1EE7a n\xF3 ti\u1EBFp t\u1EE5c
      lan r\u1ED9ng.\u201D\nNg\u01B0\u1EDDi th\u1EF1c hi\u1EC7n nghi th\u1EE9c: \u201C\u0110\u01B0a
      nh\u1EEFng ng\u01B0\u1EDDi b\u1ECB th\u01B0\u01A1ng ra ph\xEDa c\u1EEDa.\u201D"
    characterPortrait: {fileID: 0}
    backgroundSprite: {fileID: 21300000, guid: 6c836e25eb7844e4db1ca998a4607987, type: 3}
  - displayMode: 0
    speakerName: "Ng\u01B0\u1EDDi th\u1EF1c hi\u1EC7n nghi th\u1EE9c"
    dialogueText: "C\xE1c k\xFD hi\u1EC7u \u0111ang ph\u1EA3n \u1EE9ng\u2026 Gi\u1EEF
      nguy\xEAn v\u1ECB tr\xED!\u201D\nGi\u1ECDng k\u1EC3: \u201C\xC1nh s\xE1ng t\u1EEB
      b\u1ED1n tr\u1EE5 n\u1ED1i l\u1EA1i, bao quanh th\u1EF1c th\u1EC3 \u1EDF gi\u1EEFa
      s\u1EA3nh.\u201D\n"
    characterPortrait: {fileID: 0}
    backgroundSprite: {fileID: 21300000, guid: 0683dfa0ca0375c46b3e19404a9899a5, type: 3}
  - displayMode: 0
    speakerName: "Ng\u01B0\u1EDDi \u0111\u1EE9ng g\u1EA7n tr\u1EE5 "
    dialogueText: "\u201CC\xF3 th\u1EE9 g\xEC \u0111\xF3 b\xEAn trong \xE1nh s\xE1ng!\u201D\nNg\u01B0\u1EDDi
      kh\xE1c: \u201C\u0110\u1EEBng r\u1EDDi kh\u1ECFi tr\u1EE5!\u201D"
    characterPortrait: {fileID: 0}
    backgroundSprite: {fileID: 21300000, guid: 97b6714300a3db74a9961bfce4e8ec89, type: 3}
  - displayMode: 0
    speakerName: 
    dialogueText: "\u201CL\u1EDBp phong \u1EA5n d\u1EA7n kh\xE9p l\u1EA1i. \xC1nh
      s\xE1ng c\u1EE7a H\u1EA3i T\xE2m y\u1EBFu \u0111i, r\u1ED3i bi\u1EBFn m\u1EA5t
      kh\u1ECFi t\u1EA7m m\u1EAFt h\u1ECD.\u201D Ng\u01B0\u1EDDi th\u1EF1c hi\u1EC7n
      nghi th\u1EE9c: \u201CN\xF3\u2026 \u0111\xE3 ng\u1EEBng chuy\u1EC3n \u0111\u1ED9ng
      r\u1ED3i.\u201D"
    characterPortrait: {fileID: 0}
    backgroundSprite: {fileID: 21300000, guid: 97b6714300a3db74a9961bfce4e8ec89, type: 3}
  - displayMode: 0
    speakerName: Minh
    dialogueText: "Minh: \u201CHay th\u1EE9 \u0111\xF3 v\u1EABn lu\xF4n ch\u1EDD
      \u1EDF b\xEAn trong?\u201D"
    characterPortrait: {fileID: 0}
    backgroundSprite: {fileID: 21300000, guid: a6eda4078607a0c45adccfc9720de40c, type: 3}
  - displayMode: 0
    speakerName: 
    dialogueText: "\u201CNh\u1EEFng ng\u01B0\u1EDDi s\u1ED1ng s\xF3t r\u1EDDi kh\u1ECFi
      n\u01A1i \u1EA5y. Kh\xF4ng ai c\xF2n \u0111\u1EE9ng l\u1EA1i \u0111\u1EC3 nh\xECn
      xem \u0111i\u1EC1u g\xEC ti\u1EBFp t\u1EE5c di\u1EC5n ra ph\xEDa sau phong
      \u1EA5n.\u201D\nMinh, khi tr\u1EDF l\u1EA1i: \u201CH\u1ECD \u0111\xE3 th\xE0nh
      c\xF4ng sao?\u201D"
    characterPortrait: {fileID: 0}
    backgroundSprite: {fileID: 21300000, guid: a6eda4078607a0c45adccfc9720de40c, type: 3}
