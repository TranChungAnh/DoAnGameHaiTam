  lines:
  - displayMode: 0
    speakerName: 
    dialogueText: 
    characterPortrait: {fileID: -189674907, guid: f19ca5cf7c2cf2a4aa7e4a279bb8900e, type: 3}
    backgroundSprite: {fileID: 21300000, guid: e8c770717340d474489cbc9528795bd8, type: 3}
  - displayMode: 0
    speakerName: Minh
    dialogueText: "\u201CBa m\u01B0\u01A1i ng\xE0y\u2026 Kh\xF4ng ph\u1EA3i b\u1EA3y
      ng\xE0y.\u201D"
    characterPortrait: {fileID: 958862177, guid: 9291e4e87da89f2488cb842056be6a22, type: 3}
    backgroundSprite: {fileID: 21300000, guid: 115e7910ea643944a9f5f3caa528a162, type: 3}
  - displayMode: 0
    speakerName: "Nguy\u1EC5n An "
    dialogueText: " \u201CCon c\xF3 ch\u1EAFc nh\u1EEFng g\xEC con nh\u1EDB b\xE2y
      gi\u1EDD l\xE0 s\u1EF1 th\u1EADt kh\xF4ng?\u201D"
    characterPortrait: {fileID: -189674907, guid: f19ca5cf7c2cf2a4aa7e4a279bb8900e, type: 3}
    backgroundSprite: {fileID: 21300000, guid: 495b8b36dbd5cb542bfd1c3ca5ae2469, type: 3}
  - displayMode: 0
    speakerName: 
    dialogueText: "\u201CTh\u1EDDi gian ch\u01B0a bao gi\u1EDD b\u1ECB ph\xE1 v\u1EE1.\u201D
      \u2192 \u201CCh\u1EC9 c\xF3 k\xFD \u1EE9c c\u1EE7a con ng\u01B0\u1EDDi b\u1ECB
      ph\xE1 v\u1EE1.\u201D "
    characterPortrait: {fileID: 958862177, guid: 9291e4e87da89f2488cb842056be6a22, type: 3}
    backgroundSprite: {fileID: 21300000, guid: 43b7d972152078e4e9b82aeae8baa767, type: 3}
  - displayMode: 0
    speakerName: 
    dialogueText: "\u201CTHE END\u201D."
    characterPortrait: {fileID: 958862177, guid: 9291e4e87da89f2488cb842056be6a22, type: 3}
    backgroundSprite: {fileID: 21300000, guid: 43b7d972152078e4e9b82aeae8baa767, type: 3}
