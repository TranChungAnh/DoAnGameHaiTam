  m_Script: {fileID: 11500000, guid: 5b9d68f96c245d44bbeb3b0dd287c065, type: 3}
  m_Name: Map3_10
  m_EditorClassIdentifier: 
  dialogueID: 10
  lines:
  - displayMode: 0
    speakerName: 
    dialogueText: "\u201C\u0110\xFAng l\xE0 n\xF3... k\xFD hi\u1EC7u n\xE0y v\u1EABn
      c\xF2n \u1EDF \u0111\xE2y.\u201D"
    characterPortrait: {fileID: -189674907, guid: f19ca5cf7c2cf2a4aa7e4a279bb8900e, type: 3}
    backgroundSprite: {fileID: 21300000, guid: 374534a5775c0d2499eb7f43a2faaa3c, type: 3}
  - displayMode: 0
    speakerName: 
    dialogueText: "\u201CM\xECnh \u0111\xE3 t\xECm th\u1EA5y n\u01A1i n\xE0y. Nh\u01B0ng
      t\u1EA1i sao l\u1EA1i kh\xF4ng nh\u1EDB \u0111\u01B0\u1EDDng quay v\u1EC1?\u201D
      / \u201CKh\xF4ng \u0111\u01B0\u1EE3c \u0111\u1EC3 ch\xFAng l\u1EA5y m\u1EA5t
      th\u1EE9 \u0111\xF3...\u201D"
    characterPortrait: {fileID: 958862177, guid: 9291e4e87da89f2488cb842056be6a22, type: 3}
    backgroundSprite: {fileID: 21300000, guid: 7bda18463789f784c84df5cc7aefd436, type: 3}
  - displayMode: 0
    speakerName: Minh
    dialogueText: " \u201CPhi\u1EBFn \u0111\xE1 n\xE0y... c\xF3 ph\u1EA3i m\xECnh
      \u0111\xE3 t\u1EEBng ch\u1EA1m v\xE0o n\xF3 kh\xF4ng?\u201D"
    characterPortrait: {fileID: -189674907, guid: f19ca5cf7c2cf2a4aa7e4a279bb8900e, type: 3}
    backgroundSprite: {fileID: 21300000, guid: 080395641bbedc648b1be70227b9fbc9, type: 3}
